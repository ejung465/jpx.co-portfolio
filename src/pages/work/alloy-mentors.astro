---
import CaseStudy from "@/layouts/CaseStudy.astro";
import { projects } from "@/data/projects";

const project = projects.find((p) => p.slug === "alloy-mentors")!;
---

<CaseStudy project={project}>
  <div class="prose-case mt-20">
    <h2>In development</h2>
    <p>
      Alloy Mentors is a mentorship application currently in design and engineering, heading for the App
      Store. The full record of this engagement — the brief, the architecture, and the colophon — will be
      published here at launch rather than sketched out in advance.
    </p>
  </div>
</CaseStudy>
