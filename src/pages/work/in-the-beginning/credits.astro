---
import CaseStudy from "@/layouts/CaseStudy.astro";
import Notes from "@/components/case-notes/InTheBeginning.astro";
import { projects } from "@/data/projects";

const project = projects.find((p) => p.slug === "in-the-beginning")!;

/**
 * Client-facing twin of /work/in-the-beginning, linked from inthebegin.org's
 * credits. While that site is offline its return link would land on a 503, so
 * this route uses the portfolio's own back link. Restore
 * backLink={{ href: "https://inthebegin.org", label: "In The Beginning" }}
 * if the site comes back.
 */
---

<CaseStudy project={project}>
  <Notes />
</CaseStudy>
