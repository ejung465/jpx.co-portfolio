---
import Base from "@/layouts/Base.astro";
import Frame from "@/components/Frame.astro";
import { projects, clientWork, products } from "@/data/projects";

// Full class names, written out so Tailwind's content scan keeps them.
const statusKey = {
  "In service": "index__status--live",
  "In development": "index__status--dev",
  Offline: "index__status--offline",
} as const;

const bySlug = Object.fromEntries(projects.map((p) => [p.slug, p]));

// What I do, cross-referenced to where it was actually done.
const disciplines = [
  {
    title: "Interface design",
    body: "Type systems, layout, and motion — the small, deliberate details that make a site feel considered rather than assembled.",
    refs: ["nh-small-claims", "miw-architects", "ambry-calendar"],
  },
  {
    title: "Web applications",
    body: "Accounts, review queues, dashboards, and the administrative tooling an organization runs every day without calling a developer.",
    refs: ["in-the-beginning", "alloy-mentors"],
  },
  {
    title: "Native apps",
    body: "SwiftUI for Mac and iPhone — camera, audio, and on-device machine vision included — and React Native when one codebase needs to reach both stores.",
    refs: ["blockwork-one", "ambry-calendar", "alloy-mentors"],
  },
  {
    title: "Data & infrastructure",
    body: "Postgres and MongoDB, object storage, realtime sync, authentication, and deployments you own outright.",
    refs: ["in-the-beginning", "alloy-mentors", "ambry-calendar"],
  },
  {
    title: "Care after launch",
    body: "Content workflows a non-technical team can run on its own, and a direct line to the person who built it when something changes.",
    refs: ["nh-small-claims", "miw-architects"],
  },
];

const principles = [
  {
    title: "One point of contact.",
    body: "No account managers, no handoffs. You talk to the person writing the code, from the first call to the last deploy.",
  },
  {
    title: "Built to be handed over.",
    body: "Software is finished when the people who own it can run it alone. Every build ships with tools its stewards can operate.",
  },
  {
    title: "Durable by default.",
    body: "Conventional architecture, infrastructure you own, and no dependency that can't be replaced. It should still be maintainable years from now.",
  },
];

const toolbox = [
  "TypeScript",
  "React",
  "Next.js",
  "Astro",
  "Swift & SwiftUI",
  "Vision & AVFoundation",
  "React Native",
  "PostgreSQL",
  "Supabase",
  "MongoDB",
  "Tailwind CSS",
  "Vercel",
  "Cloudflare",
];
---

<Base
  title="JPX Website Development Co. — Websites, web apps & native apps"
  description="A one-person studio designing and building websites, web applications, and native apps for small businesses, nonprofits, and its own products."
>
  <div class="shell">
    <!-- ── Hero ─────────────────────────────────────────────── -->
    <section class="hero" aria-labelledby="hero-title">
      <h1 id="hero-title" class="hero__title">
        <span class="line"><span>Small studio.</span></span>
        <span class="line"><span class="soft">Serious software.</span></span>
      </h1>

      <div class="hero__foot">
        <p class="hero__lede" data-hero-fade>
          JPX is <strong>Ethan Jung</strong> — designing and building websites, web applications, and native apps for
          small businesses, nonprofits, and a few products of my own. One person, start to finish.
        </p>

        <div class="hero__actions" data-hero-fade="2">
          <a href="/contact" class="btn">Start a project <span class="arr" aria-hidden="true">→</span></a>
          <a class="link link-soft" href="#work">See the work <span class="arr" aria-hidden="true">↓</span></a>
        </div>
      </div>
    </section>

    <!-- ── Index ────────────────────────────────────────────── -->
    <section aria-label="Project index" data-hero-fade="2">
      <div class="index" data-index>
        <div class="index__head" aria-hidden="true">
          <span>Index</span>
          <span>{projects.length} projects · {clientWork.length} client, {products.length} in-house</span>
        </div>
        {projects.map((p, i) => (
          <a href={p.href} class="index__row" data-slug={p.slug}>
            <span class="index__n">{String(i + 1).padStart(2, "0")}</span>
            <span class="index__name">{p.name}</span>
            <span class="index__cat">{p.category}</span>
            <span class="index__plat">{p.platforms}</span>
            <span class={`index__status ${statusKey[p.status]}`}>
              <i aria-hidden="true"></i><span>{p.status}</span>
            </span>
            <span class="index__go" aria-hidden="true">→</span>
          </a>
        ))}
      </div>
    </section>

    <!-- lives outside the animated section: a transformed ancestor would break position: fixed -->
    <div class="index-preview" aria-hidden="true">
      {projects.map((p) => <img src={p.image} alt="" data-slug={p.slug} width="1200" height="750" loading="lazy" decoding="async" />)}
    </div>

    <!-- ── Client work ──────────────────────────────────────── -->
    <section id="work" class="section scroll-mt-28" aria-labelledby="work-title">
      <div class="section-head" data-reveal>
        <h2 id="work-title">Client work<span class="count">{String(clientWork.length).padStart(2, "0")}</span></h2>
        <p class="hidden sm:block">Interface, data layer, and the tooling clients run day to day</p>
      </div>

      <div class="features">
        {clientWork.map((p, i) => (
          <article class:list={["feature", i % 2 === 1 && "feature--flip"]}>
            <div class="feature__media">
              <Frame project={p} transition />
            </div>

            <div class="feature__body" data-reveal>
              <p class="feature__meta">
                <span class="n">{String(i + 1).padStart(2, "0")}</span>
                <span>{p.category}</span>
                <span aria-hidden="true">·</span>
                <span>{p.year}</span>
              </p>
              <h3>{p.name}</h3>
              <p class="feature__headline">{p.headline}</p>
              <p class="feature__summary">{p.summary}</p>

              <dl class="feature__facts">
                <dt>Role</dt>
                <dd>{p.engagement.practice}, {p.engagement.scope.toLowerCase()}</dd>
                <dt>Built with</dt>
                <dd>{p.stack.slice(0, 4).join(", ")}</dd>
                <dt>Status</dt>
                <dd>
                  <span class={`index__status ${statusKey[p.status]}`}>
                    <i aria-hidden="true"></i><span>{p.status}</span>
                  </span>
                </dd>
              </dl>

              <div class="feature__links">
                <a href={p.href} class="link">Read the case study <span class="arr" aria-hidden="true">→</span></a>
                {p.external && (
                  <a href={p.external} class="link link-soft" target="_blank" rel="noopener noreferrer">
                    Visit {p.displayUrl} <span class="arr arr--ext" aria-hidden="true">↗</span>
                  </a>
                )}
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- ── Products ─────────────────────────────────────────── -->
    <section id="products" class="section scroll-mt-28" aria-labelledby="products-title">
      <div class="section-head" data-reveal>
        <h2 id="products-title">Products<span class="count">{String(products.length).padStart(2, "0")}</span></h2>
        <p class="hidden sm:block">Designed, built, and run by JPX</p>
      </div>

      <p class="section-intro" data-reveal>
        Alongside client work, I build and run software of my own. <span class="soft">It's where the hard problems get
        solved first — and where clients' projects quietly benefit.</span>
      </p>

      <div class="tiles">
        {products.map((p, i) => (
          <article class="tile" style={`--brand: ${p.brand}; --i: ${i}`} data-reveal>
            <div class="tile__body">
              <img class="tile__icon" src={p.icon} alt="" width="64" height="64" loading="lazy" />
              <h3>{p.name}</h3>
              <p class="tile__headline">{p.headline}</p>
              <p class="tile__plat">{p.platforms} · {p.status}</p>
              <div class="tile__links">
                <a href={p.href} class="link">Learn more <span class="arr" aria-hidden="true">→</span></a>
                {p.external && (
                  <a href={p.external} class="link link-soft" target="_blank" rel="noopener noreferrer">
                    {p.displayUrl} <span class="arr arr--ext" aria-hidden="true">↗</span>
                  </a>
                )}
              </div>
            </div>
            <div class="tile__media">
              <Frame project={p} transition />
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- ── What I do ────────────────────────────────────────── -->
    <section id="disciplines" class="section scroll-mt-28" aria-labelledby="disciplines-title">
      <div class="section-head" data-reveal>
        <h2 id="disciplines-title">What I do</h2>
        <p class="hidden sm:block">And where you can see it</p>
      </div>

      <div class="disciplines">
        {disciplines.map((d, i) => (
          <div class="discipline" data-reveal style={`--i: ${i}`}>
            <h3>{d.title}</h3>
            <p>{d.body}</p>
            <div class="discipline__refs">
              {d.refs.map((slug) => (
                <a href={bySlug[slug].href} class="tag tag-muted">{bySlug[slug].name}</a>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- ── Principal ────────────────────────────────────────── -->
    <section id="principal" class="section scroll-mt-28" aria-labelledby="principal-title">
      <div class="section-head" data-reveal>
        <h2>About</h2>
        <p class="hidden sm:block">The person behind JPX</p>
      </div>

      <div class="principal">
        <div data-reveal>
          <h3 id="principal-title" class="principal__name">Ethan Jung</h3>
          <p class="principal__role">Founder & principal, JPX Website Development Co.</p>

          <dl class="facts">
            <div><dt>Practice</dt><dd>Design & engineering</dd></div>
            <div><dt>Works with</dt><dd>Small businesses, nonprofits</dd></div>
            <div><dt>Currently</dt><dd>Shipping Blockwork One, Ambry Calendar, and Alloy Mentors</dd></div>
            <div><dt>Email</dt><dd><a href="mailto:info@jpxco.dev">info@jpxco.dev</a></dd></div>
          </dl>
        </div>

        <div data-reveal style="--i: 1">
          <div class="principal__bio">
            <p>JPX is me. I design and build the whole thing — not just the page you see, but the system underneath it.</p>
            <p>
              Registration flows, admin dashboards, review queues, sync engines: the unglamorous plumbing that makes an
              organization's day-to-day actually work. I'm the single point of authorship on every engagement, from the
              first wireframe to production — and this site is a fair sample of the standard.
            </p>
            <p>
              Small businesses and nonprofits get the same rate, the same code quality, and the same attention. If a
              project isn't a good fit, I'll say so upfront instead of taking it anyway.
            </p>
          </div>

          <div class="principles">
            {principles.map((p) => (
              <div class="principle">
                <h4 class="font-semibold" style="font-size: var(--t-md); line-height: 1.4;">{p.title}</h4>
                <p>{p.body}</p>
              </div>
            ))}
          </div>

          <div class="mt-10">
            <p style="font-size: var(--t-sm); color: var(--ink-faint);">Toolbox</p>
            <ul class="flex flex-wrap gap-2 mt-4">
              {toolbox.map((t) => <li class="tag">{t}</li>)}
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- ── Close ────────────────────────────────────────────── -->
    <section class="closer" aria-labelledby="closer-title" data-reveal>
      <h2 id="closer-title">Have a project<br /><span class="soft">in mind?</span></h2>
      <p>Tell me what you're trying to build. I'll tell you honestly whether I'm the right fit — usually within a day.</p>
      <div class="closer__actions">
        <a href="/contact" class="btn">Start a project <span class="arr" aria-hidden="true">→</span></a>
        <a href="mailto:info@jpxco.dev" class="link link-soft">info@jpxco.dev</a>
        <a href="tel:+12247249020" class="link link-soft">(224) 724-9020</a>
      </div>
    </section>
  </div>
</Base>
