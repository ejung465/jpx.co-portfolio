---
import Base from "@/layouts/Base.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import { projects } from "@/data/projects";

const approach = [
  {
    title: "One point of contact",
    body: "No account managers, no handoffs. You talk to the person writing the code, from the first call to the last deploy.",
  },
  {
    title: "Built to be handed over",
    body: "Software is only finished when the people who own it can run it alone. Every build ships with an interface its stewards can operate without an engineer present.",
  },
  {
    title: "Durable by default",
    body: "Conventional architecture, infrastructure you own, and no dependency that cannot be replaced. What is built this year should still be maintainable long after.",
  },
];
---

<Base
  title="JPX Website Development Co. — Full-stack web development"
  description="Full-stack web development for small businesses and nonprofits. Built properly, by one person who picks up the phone."
>
  <div class="shell">
    <!-- ── Masthead ─────────────────────────────────────────── -->
    <section class="pt-24 pb-24 md:pt-36 md:pb-32">
      <p class="availability">
        <span class="availability__dot"></span> Available — taking on new projects
      </p>

      <h1 class="text-[42px] md:text-[68px] leading-[1.04] mt-8 max-w-[15ch]">
        Full-stack web development for small businesses <em class="em-accent">and nonprofits.</em>
      </h1>

      <div class="rule mt-10"></div>

      <p class="lede max-w-[46ch] mt-8">
        Built properly, by one person who picks up the phone — design, code, and the unglamorous
        infrastructure in between.
      </p>

      <div class="flex items-center gap-8 flex-wrap mt-10">
        <a href="/contact" class="btn">Book a 20-min call</a>
        <a class="link-ghost" href="#work">See the work <span class="arr">→</span></a>
      </div>
    </section>

    <!-- ── Selected work ────────────────────────────────────── -->
    <section id="work" class="section scroll-mt-28">
      <div class="rail">
        <p class="eyebrow pt-1">Selected work</p>

        <div>
          <p class="max-w-[52ch] mb-10" style="color: var(--ink-soft);">
            Four engagements, built end to end — the interface, the data layer, and the administrative
            tooling the client actually runs day to day.
          </p>

          <div class="grid sm:grid-cols-2 gap-5">
            {projects.map((project) => (
              <div class={project.wide ? "sm:col-span-2" : ""}>
                <ProjectCard project={project} />
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- ── How I work ───────────────────────────────────────── -->
    <section id="approach" class="section scroll-mt-28">
      <div class="rail">
        <p class="eyebrow pt-1">How I work</p>

        <div class="numbered">
          {approach.map((item, i) => (
            <div class="numbered__row">
              <span class="numbered__n">{String(i + 1).padStart(2, "0")}</span>
              <div>
                <h3>{item.title}</h3>
                <p>{item.body}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ── Principal ────────────────────────────────────────── -->
    <section id="principal" class="section scroll-mt-28">
      <div class="rail">
        <p class="eyebrow pt-1">Principal</p>

        <div>
          <h2 class="text-[32px] md:text-[40px]">Ethan Jung</h2>
          <p
            class="font-mono uppercase mt-3"
            style="font-size: var(--t-micro); letter-spacing: var(--track-label); color: var(--ink-faint);"
          >
            Founder · Systems Architect
          </p>

          <div class="prose-case mt-8 max-w-[62ch]">
            <p>
              JPX is me. I design and build websites and web applications for small businesses and
              nonprofits — not templated marketing pages, but the infrastructure underneath: registration
              flows, admin dashboards, and the unglamorous plumbing that makes an organization's day-to-day
              actually work.
            </p>
            <p>
              Single point of authorship on every engagement, from the first wireframe to production —
              interface design, application architecture, data modeling, infrastructure, and the editorial
              systems that keep a site current after launch. This site is a fair sample of the standard: the
              type ramp, the grid, and the case studies were all built the same way I'd build yours.
            </p>
            <p>
              Small businesses and nonprofits get the same rate, the same code quality, and the same
              attention. I don't treat one as charity work and the other as the real job — and if a project
              isn't a good fit, I'll say so upfront instead of taking it anyway.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- ── Enquiries ────────────────────────────────────────── -->
    <section class="section">
      <div class="rail">
        <p class="eyebrow pt-1">Enquiries</p>

        <div>
          <h2 class="text-[32px] md:text-[44px] max-w-[20ch]">
            Have a project <em class="em-accent">in mind?</em>
          </h2>
          <p class="max-w-[46ch] mt-6" style="color: var(--ink-soft);">
            Tell me what you're trying to build. I'll tell you honestly whether I'm the right fit.
          </p>

          <div class="flex flex-wrap items-center gap-8 mt-10">
            <a href="/contact" class="btn">Book a 20-min call</a>
            <div
              class="flex flex-wrap items-center gap-x-8 gap-y-2 font-mono uppercase"
              style="font-size: var(--t-micro); letter-spacing: var(--track-label); color: var(--ink-faint);"
            >
              <a href="mailto:info@jpxco.dev" class="enq-link">info@jpxco.dev</a>
              <a href="tel:+12247249020" class="enq-link">(224) 724-9020</a>
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>
</Base>

<style>
  .enq-link {
    text-decoration: none;
    color: inherit;
    transition: color 0.18s ease;
  }
  .enq-link:hover {
    color: var(--accent);
  }
</style>
