---
const year = 2026;

// The footer carries navigation now that the header rail is gone.
const links = [
  { href: "/#work", label: "Work" },
  { href: "/#principal", label: "Principal" },
  { href: "/contact", label: "Contact" },
];
---

<footer class="mt-24">
  <div class="shell" style="border-top: 1px solid var(--glass-line);">
    <!-- masthead -->
    <div class="pt-20 text-center">
      <p class="font-serif leading-none" style="font-size: 64px;">JPX</p>
      <p
        class="font-mono uppercase mt-4"
        style="font-size: var(--t-micro); letter-spacing: 0.34em; color: var(--ink-faint);"
      >
        Website Development Co.
      </p>
    </div>

    <!-- navigation + contact -->
    <div
      class="mt-16 pt-8 flex flex-col sm:flex-row items-center justify-between gap-6 font-mono uppercase"
      style="border-top: 1px solid var(--glass-line); font-size: var(--t-micro); letter-spacing: var(--track-label); color: var(--ink-faint);"
    >
      <div class="flex flex-wrap items-center justify-center gap-x-8 gap-y-3">
        {links.map((l) => <a href={l.href} class="foot-link">{l.label}</a>)}
      </div>
      <div class="flex flex-wrap items-center justify-center gap-x-8 gap-y-3">
        <a href="mailto:info@jpxco.dev" class="foot-link">info@jpxco.dev</a>
        <a href="tel:+12247249020" class="foot-link">(224) 724-9020</a>
      </div>
    </div>

    <!-- colophon line -->
    <div class="py-12 text-center font-mono uppercase" style="color: var(--ink-faint);">
      <p style="font-size: var(--t-micro); letter-spacing: var(--track-label);">
        A product of JPX Website Development Co.
      </p>
      <p class="mt-2" style="font-size: var(--t-nano); letter-spacing: 0.26em; opacity: 0.72;">All rights reserved</p>
      <p class="mt-3" style="font-size: var(--t-nano); letter-spacing: 0.26em; opacity: 0.72;">© {year}</p>
    </div>
  </div>
</footer>

<style>
  .foot-link {
    text-decoration: none;
    color: inherit;
    transition: color 0.18s ease;
  }
  .foot-link:hover {
    color: var(--accent);
  }
</style>
