---
import Logo from "@/components/Logo.astro";
import { projects } from "@/data/projects";

const year = 2026;
---

<footer class="mt-32">
  <div class="shell">
    <div class="grid gap-12 py-16 md:grid-cols-[1.4fr_1fr_1fr_1fr]" style="border-top: 1px solid var(--glass-line);">
      <div>
        <a href="/" aria-label="JPX Co — home" class="inline-block" style="color: var(--ink);">
          <Logo class="block h-[88px] w-auto" />
        </a>
        <p class="mt-5" style="font-size: var(--t-sm); color: var(--ink-soft);">Website Development Co.</p>
        <p class="mt-6 max-w-[30ch]" style="font-size: var(--t-sm); color: var(--ink-faint);">
          Websites, web apps, and native apps — designed and built by Ethan Jung.
        </p>
      </div>

      <nav aria-label="Work">
        <p style="font-size: var(--t-sm); color: var(--ink-faint);">Work</p>
        <ul class="mt-3" style="font-size: var(--t-sm);">
          {projects.map((p) => <li><a href={p.href} class="foot-link">{p.name}</a></li>)}
        </ul>
      </nav>

      <nav aria-label="Studio">
        <p style="font-size: var(--t-sm); color: var(--ink-faint);">Studio</p>
        <ul class="mt-3" style="font-size: var(--t-sm);">
          <li><a href="/#work" class="foot-link">Client work</a></li>
          <li><a href="/#products" class="foot-link">Products</a></li>
          <li><a href="/#principal" class="foot-link">About</a></li>
          <li><a href="/contact" class="foot-link">Start a project</a></li>
        </ul>
      </nav>

      <div>
        <p style="font-size: var(--t-sm); color: var(--ink-faint);">Contact</p>
        <ul class="mt-3" style="font-size: var(--t-sm);">
          <li><a href="mailto:info@jpxco.dev" class="foot-link">info@jpxco.dev</a></li>
          <li><a href="tel:+12247249020" class="foot-link">(224) 724-9020</a></li>
        </ul>
      </div>
    </div>

    <div
      class="flex flex-col sm:flex-row justify-between gap-2 py-8"
      style="border-top: 1px solid var(--glass-line); font-size: var(--t-xs); color: var(--ink-faint);"
    >
      <p>© {year} JPX Website Development Co. All rights reserved.</p>
      <p>Designed and built in-house — this site included.</p>
    </div>
  </div>
</footer>
