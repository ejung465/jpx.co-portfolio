---
const year = 2026;
---

<footer class="mt-28">
  <div
    class="max-w-[1080px] mx-auto px-8 py-12 flex flex-col sm:flex-row items-start sm:items-end justify-between gap-8"
    style="border-top: 1px solid var(--glass-line);"
  >
    <div>
      <p class="font-serif text-[26px] leading-none">JPX</p>
      <p class="font-mono text-[9.5px] uppercase mt-3" style="letter-spacing: 0.3em; color: var(--ink-faint);">
        Web Development Co.
      </p>
    </div>

    <div class="flex flex-wrap items-center gap-x-7 gap-y-2 font-mono text-[10px] uppercase" style="letter-spacing: 0.18em; color: var(--ink-faint);">
      <a href="mailto:info@jpxco.dev" class="foot-link transition-colors">info@jpxco.dev</a>
      <a href="tel:+12247249020" class="foot-link transition-colors">(224) 724-9020</a>
      <a href="/contact" class="foot-link transition-colors">Book a call</a>
    </div>
  </div>

  <p class="text-center font-mono text-[9.5px] uppercase pb-10" style="letter-spacing: 0.22em; color: var(--ink-faint);">
    © {year} JPX Web Development Co. · All Rights Reserved
  </p>
</footer>

<style>
  .foot-link:hover {
    color: var(--accent);
  }
</style>
