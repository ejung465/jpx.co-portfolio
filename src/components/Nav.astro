---
const links = [
  { href: "/#work", label: "Work" },
  { href: "/#approach", label: "Approach" },
  { href: "/about", label: "About" },
  { href: "/contact", label: "Contact" },
];
---

<nav class="site-nav mx-4 sm:mx-auto">
  <a href="/" class="flex items-center gap-3" style="text-decoration: none; color: var(--ink);">
    <img src="/images/jpx-logo.png" alt="" class="nav-logo" />
    <span class="hidden sm:inline font-mono text-[10px] uppercase" style="letter-spacing: 0.28em; color: var(--ink-soft);">
      JPX Web Development Co.
    </span>
  </a>

  <div class="hidden md:flex gap-8 font-mono text-[10px] uppercase" style="letter-spacing: 0.22em; color: var(--ink-faint);">
    {links.map((link) => (
      <a href={link.href} class="nav-link transition-colors">{link.label}</a>
    ))}
  </div>

  <div class="flex items-center gap-2">
    <a
      href="/contact"
      class="font-mono text-[10px] uppercase rounded-[9px] px-[15px] py-[10px] transition-colors"
      style="letter-spacing: 0.18em; color: var(--accent); border: 1px solid rgba(200,169,106,.35);"
    >
      Book a call
    </a>
    <button
      id="nav-toggle"
      aria-label="Toggle menu"
      aria-expanded="false"
      class="md:hidden grid place-items-center w-9 h-9 rounded-[9px]"
      style="border: 1px solid var(--glass-line); color: var(--ink-soft);"
    >
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M1 4h14M1 8h14M1 12h14" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
      </svg>
    </button>
  </div>
</nav>

<div id="nav-mobile" class="glass md:hidden mx-4 mt-2 rounded-[14px] p-2 hidden">
  {links.map((link) => (
    <a
      href={link.href}
      class="block px-4 py-3 font-mono text-[11px] uppercase rounded-[9px]"
      style="letter-spacing: 0.2em; color: var(--ink-soft);"
    >
      {link.label}
    </a>
  ))}
</div>

<style>
  .nav-link:hover,
  #nav-mobile a:hover {
    color: var(--accent);
  }
  a[href="/contact"]:hover {
    background: rgba(200, 169, 106, 0.1);
  }
</style>

<script>
  const toggle = document.getElementById("nav-toggle");
  const menu = document.getElementById("nav-mobile");
  toggle?.addEventListener("click", () => {
    const isOpen = !menu?.classList.contains("hidden");
    menu?.classList.toggle("hidden");
    toggle.setAttribute("aria-expanded", String(!isOpen));
  });
</script>
