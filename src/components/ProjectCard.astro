---
import type { Project } from "@/data/projects";

interface Props {
  project: Project;
}
const { project } = Astro.props;

// The preview opens the live site; the title opens the case study.
// Two sibling links rather than nested anchors (which would be invalid).
const previewHref = project.external ?? project.href;
const isExternal = Boolean(project.external);
---

<article class="project-card">
  <a
    href={previewHref}
    class="project-shot"
    target={isExternal ? "_blank" : undefined}
    rel={isExternal ? "noopener noreferrer" : undefined}
    aria-label={isExternal ? `Open ${project.name} in a new tab` : `${project.name} case study`}
  >
    <div class="browser-chrome__bar">
      <i></i><i></i><i></i>
      <span>{project.displayUrl}</span>
      {isExternal && <span class="ext" aria-hidden="true">↗</span>}
    </div>

    {project.frame === "phone" ? (
      <div class="phone-stage">
        <div class="phone-frame">
          <img src={project.image} alt={project.imageAlt} loading="lazy" decoding="async" />
        </div>
      </div>
    ) : (
      <div class="card-shot">
        <img src={project.image} alt={project.imageAlt} loading="lazy" decoding="async" />
      </div>
    )}
  </a>

  <a href={project.href} class="project-meta">
    <div>
      <div class="t">{project.name}</div>
      <div class="s">{project.tagline}</div>
    </div>
    <span class={project.status === "In service" ? "tag" : "tag tag-muted"}>{project.status}</span>
  </a>
</article>
