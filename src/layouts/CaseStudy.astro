---
import Base from "@/layouts/Base.astro";
import Frame from "@/components/Frame.astro";
import { nextProject, statusClass, type Project } from "@/data/projects";

interface Props {
  project: Project;
  /**
   * Where the top-left return link points. Defaults to the work index; pass
   * `null` to hide it when this record is published somewhere else.
   */
  backLink?: { href: string; label: string } | null;
}

const { project, backLink } = Astro.props;
const back =
  backLink === undefined
    ? { href: project.kind === "product" ? "/#products" : "/#work", label: "All work" }
    : backLink;
const next = nextProject(project.slug);
const kindLabel = project.kind === "product" ? "JPX product" : "Client work";
---

<Base title={`${project.name} — JPX Website Development Co.`} description={project.metaDescription} progress>
  <div class="shell">
    <!-- ── Header ───────────────────────────────────────────── -->
    <header class="case-head">
      {back && (
        <a href={back.href} class="link link-soft">
          <span aria-hidden="true">←</span> {back.label}
        </a>
      )}

      <p class="case-head__kicker mt-10">
        {project.icon && <img src={project.icon} alt="" width="28" height="28" class="rounded-[7px]" />}
        <span style="color: var(--accent);">{kindLabel}</span>
        <span aria-hidden="true">·</span>
        <span>{project.category}</span>
      </p>
      <h1>{project.name}</h1>
      <p class="case-head__headline">{project.headline}</p>

      <dl class="spec">
        <div>
          <dt>Scope</dt>
          <dd>{project.engagement.scope}</dd>
        </div>
        <div>
          <dt>Practice</dt>
          <dd>{project.engagement.practice}</dd>
        </div>
        <div>
          <dt>Delivered</dt>
          <dd>{project.engagement.delivered}</dd>
        </div>
        <div>
          <dt>Status</dt>
          <dd>
            <span class={statusClass[project.status]}>
              <span class="status__dot" aria-hidden="true"></span>
              {project.status}
            </span>
          </dd>
        </div>
      </dl>

      {project.statusNote && <p class="status-note">{project.statusNote}</p>}
    </header>

    <!-- ── Hero capture: morphs from the homepage frame ─────── -->
    <figure class="case-hero">
      <Frame project={project} transition eager selfLink={false} />
      <figcaption class="case-hero__caption">
        <span>
          {project.external
            ? project.page
              ? `Captured from ${project.displayUrl} — hover to scroll the full page, select to visit.`
              : `Captured from ${project.displayUrl} — select to visit.`
            : `${project.displayUrl}, as delivered.`}
        </span>
        <span>{project.platforms}</span>
      </figcaption>
    </figure>
  </div>

  <div class="shell">
    <!-- ── Brief ────────────────────────────────────────────── -->
    <section class="case-block" aria-labelledby="brief-title" data-reveal>
      <h2 id="brief-title">The brief</h2>
      <p class="case-lede">{project.engagement.brief}</p>
    </section>

    <!-- ── Stack ────────────────────────────────────────────── -->
    {project.stack.length > 0 && (
      <section class="case-block" aria-labelledby="stack-title" data-reveal>
        <h2 id="stack-title">Built with</h2>
        <ul class="flex flex-wrap gap-2">
          {project.stack.map((t) => <li class="tag">{t}</li>)}
          {project.external && (
            <li>
              <a href={project.external} target="_blank" rel="noopener noreferrer" class="tag tag-muted">
                {project.displayUrl} <span aria-hidden="true">↗</span>
              </a>
            </li>
          )}
        </ul>
      </section>
    )}

    <!-- ── Colophon ─────────────────────────────────────────── -->
    {project.colophon.length > 0 && (
      <section class="case-block" aria-labelledby="colophon-title">
        <h2 id="colophon-title" data-reveal>Colophon</h2>
        <div class="colophon">
          {project.colophon.map((entry, i) => (
            <div class="colophon__row" data-reveal style={`--i: ${i % 3}`}>
              <h3>{entry.title}</h3>
              <p>{entry.body}</p>
            </div>
          ))}
        </div>
      </section>
    )}

    <!-- ── Long-form notes, per project ─────────────────────── -->
    <slot />

    <!-- ── Next ─────────────────────────────────────────────── -->
    <a href={next.href} class="next" data-reveal>
      <div>
        <p class="next__label">Next project</p>
        <p class="next__name">{next.name} <span aria-hidden="true">→</span></p>
        <p class="next__headline">{next.headline}</p>
      </div>
      <div class="next__shot">
        <img src={next.image} alt="" width="1200" height="750" loading="lazy" decoding="async" />
      </div>
    </a>

    <div class="flex flex-wrap items-center gap-x-8 gap-y-2 mt-16">
      <a href="/contact" class="btn">Start a project <span class="arr" aria-hidden="true">→</span></a>
      <a class="link link-soft" href="/">Back to the index</a>
    </div>
  </div>
</Base>
